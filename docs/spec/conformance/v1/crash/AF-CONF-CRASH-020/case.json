{
  "id": "AF-CONF-CRASH-020",
  "suite": "crash",
  "title": "an explicit other jobId overrides a coincidentally matching subject",
  "kind": "derive",
  "requirements": ["AF-CRASH-002", "AF-AUTH-P-001", "AF-CRASH-R-009"],
  "description": "Replay the records with the supplied subject (atEpochMs 1010, 1020, …; jobRevision 1), then derive the crash disposition for job JOB-1 and the permit ledger. `journal-frames.bin` holds the same records framed as on disk, without the file magic.",
  "input": {
    "jobId": "JOB-1",
    "records": [
      {
        "subject": "JOB-1",
        "kind": "jobCreated",
        "facts": {
          "jobId": "JOB-1"
        }
      },
      {
        "subject": "JOB-1",
        "kind": "stepPermitAccepted",
        "facts": {
          "jobId": "JOB-2",
          "permitId": "PERMIT-OTHER"
        }
      }
    ]
  },
  "expected": {
    "crashDisposition": {
      "row": "safeToCancel",
      "permitsExternalEffect": false
    },
    "permitLedger": [
      {
        "permitId": "PERMIT-OTHER",
        "disposition": "acceptedIntentNotDurable",
        "permitsDispatch": false
      }
    ],
    "unresolvedPermits": []
  },
  "files": {
    "journal-frames.bin": {
      "bytes": 472,
      "sha256": "906ddaa354c9a13edb703b1afc13ec11d1c2fd155731d18a7ed456dcd645e736"
    }
  }
}
