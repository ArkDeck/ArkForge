{
  "id": "AF-CONF-CRASH-009",
  "suite": "crash",
  "title": "semantic receipt recorded before permitConsumed: receipt settled, checkpoint missing",
  "kind": "derive",
  "requirements": ["AF-CRASH-002", "AF-AUTH-P-001", "AF-CRASH-R-005"],
  "description": "Replay the records with the supplied subject (atEpochMs 1010, 1020, …; jobRevision 1), then derive the crash disposition for job JOB-1 and the permit ledger. `journal-frames.bin` holds the same records framed as on disk, without the file magic.",
  "input": {
    "jobId": "JOB-1",
    "records": [
      {
        "subject": "JOB-1",
        "kind": "jobCreated",
        "facts": {
          "jobId": "JOB-1"
        }
      },
      {
        "subject": "JOB-1",
        "kind": "stepPermitAccepted",
        "facts": {
          "jobId": "JOB-1",
          "stepId": "STEP-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "subject": "JOB-1",
        "kind": "stepIntentRecorded",
        "facts": {
          "jobId": "JOB-1",
          "stepId": "STEP-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "subject": "JOB-1",
        "kind": "permitConsuming",
        "facts": {
          "jobId": "JOB-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "subject": "JOB-1",
        "kind": "externalDispatchStarted",
        "facts": {
          "jobId": "JOB-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "subject": "JOB-1",
        "kind": "semanticReceiptRecorded",
        "facts": {
          "jobId": "JOB-1",
          "permitId": "PERMIT-1",
          "receiptDigest": "abc123"
        }
      }
    ]
  },
  "expected": {
    "crashDisposition": {
      "row": "receiptDurableCheckpointMissing",
      "permitsExternalEffect": false,
      "permitId": "PERMIT-1"
    },
    "permitLedger": [
      {
        "permitId": "PERMIT-1",
        "disposition": "consumed",
        "permitsDispatch": false,
        "receiptDigest": "abc123"
      }
    ],
    "unresolvedPermits": []
  },
  "files": {
    "journal-frames.bin": {
      "bytes": 1512,
      "sha256": "f464df0a74159f87a216000a169f9a51b566861bd16012eeded5438a390d5b31"
    }
  }
}
