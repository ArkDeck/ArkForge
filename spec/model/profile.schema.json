{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arkforge.dev/spec/v1/model/profile.schema.json",
  "title": "ArkForge DeviceProfile (arkforge.device-profile/v1)",
  "description": "The JSON model of a DeviceProfile document after it has been read through the strict YAML subset (spec/model/strict-yaml.md). All scalars arrive as text; the types below say what the loader accepts for each. status: draft (extracted from crates/arkforge-core/src/profile.rs load/validate). Cross-field invariants that JSON Schema cannot express are in spec/requirements/profile.md.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "profile", "identity", "providers", "artifactCompatibility", "modes", "storage", "readDomain", "dataImpact"],
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "deviceMode": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "identityLabel": {
      "description": "Visible vendor text: 1..128 UTF-8 bytes in the normative loader, no leading/trailing whitespace or control characters",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:\\S|\\S(?:[^\\u0000-\\u001F\\u007F]*\\S)?)$"
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "unsigned": {
      "description": "decimal digits, 0x/0X hex, with optional `_` separators; the YAML reader hands it over as text",
      "type": "string",
      "pattern": "^(0[xX][0-9A-Fa-f_]+|[0-9_]+)$"
    },
    "unsignedOrUnknown": {
      "oneOf": [ { "$ref": "#/$defs/unsigned" }, { "const": "unknown" } ]
    },
    "bool": { "type": "string", "enum": ["true", "false"] },
    "sha256Hex": { "type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$" },
    "dataImpactState": { "type": "string", "enum": ["preserved", "overwritten", "unknown"] },
    "identityFieldPolicy": { "type": "string", "enum": ["must-match", "may-change"] },
    "verificationStrength": { "type": "string", "enum": ["fullHash", "sampledRanges", "prefixHash", "semanticOnly"] }
  },
  "properties": {
    "schemaVersion": { "const": "arkforge.device-profile/v1" },
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueId" },
        "version": { "$ref": "#/$defs/version" },
        "expectedDigest": {
          "$ref": "#/$defs/sha256Hex",
          "description": "optional pin; when present the loader recomputes the profile digest over the canonical model and refuses a mismatch (PROFILE_DIGEST_MISMATCH)"
        }
      }
    },
    "identity": {
      "type": "object",
      "required": ["productModels", "soc", "hardwareRevisions"],
      "properties": {
        "productModels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identityLabel" } },
        "soc": {
          "type": "object",
          "required": ["vendor", "family"],
          "properties": {
            "vendor": { "$ref": "#/$defs/opaqueId" },
            "family": { "$ref": "#/$defs/opaqueId" }
          }
        },
        "hardwareRevisions": {
          "type": "object",
          "description": "either `allow` (a list; `*` is refused as a wildcard claim; empty claims nothing and blocks execution) or `anyRevisionEvidence` (an evidence ref proving revision independence)",
          "oneOf": [
            { "required": ["allow"], "properties": { "allow": { "type": "array", "items": { "allOf": [ { "$ref": "#/$defs/identityLabel" }, { "not": { "const": "*" } } ] } } } },
            { "required": ["anyRevisionEvidence"], "properties": { "anyRevisionEvidence": { "$ref": "#/$defs/opaqueId" } } }
          ]
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "backend", "minimumVersion", "maximumVersionExclusive"],
        "properties": {
          "id": { "$ref": "#/$defs/opaqueId" },
          "backend": { "$ref": "#/$defs/opaqueId" },
          "minimumVersion": { "$ref": "#/$defs/version" },
          "maximumVersionExclusive": { "$ref": "#/$defs/version" }
        }
      }
    },
    "artifactCompatibility": {
      "type": "object",
      "required": ["formats"],
      "properties": {
        "formats": { "type": "array", "items": { "$ref": "#/$defs/opaqueId" } },
        "knownMetadataMembers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "archive members the parser reports as unclassified that this profile discharges; any other unclassified member blocks an executable plan (RK-A02)"
        }
      }
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/deviceMode" },
          "aliases": { "type": "array", "items": { "$ref": "#/$defs/deviceMode" } }
        }
      }
    },
    "usbIdentities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mode", "vendorId", "productId", "evidenceRef"],
        "properties": {
          "mode": { "$ref": "#/$defs/deviceMode" },
          "vendorId": { "$ref": "#/$defs/unsigned" },
          "productId": { "$ref": "#/$defs/unsigned" },
          "evidenceRef": { "$ref": "#/$defs/opaqueId" }
        }
      }
    },
    "modeTransitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "action", "serialPolicy", "topologyPolicy", "rebind"],
        "properties": {
          "from": { "$ref": "#/$defs/deviceMode" },
          "to": { "$ref": "#/$defs/deviceMode" },
          "action": { "$ref": "#/$defs/opaqueId" },
          "serialPolicy": { "$ref": "#/$defs/identityFieldPolicy" },
          "topologyPolicy": { "$ref": "#/$defs/identityFieldPolicy" },
          "rebind": {
            "type": "object",
            "required": ["requireDisconnect", "toleranceWindowMs", "tolerateTransientMalformed"],
            "properties": {
              "requireDisconnect": { "$ref": "#/$defs/bool" },
              "toleranceWindowMs": { "$ref": "#/$defs/unsigned", "description": "must be > 0" },
              "tolerateTransientMalformed": { "$ref": "#/$defs/bool" }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["kind", "logicalBlockSize"],
      "properties": {
        "kind": { "$ref": "#/$defs/opaqueId" },
        "logicalBlockSize": { "$ref": "#/$defs/unsignedOrUnknown", "description": "0 is refused (ZeroBlockSize); `unknown` blocks execution" }
      }
    },
    "readDomain": {
      "type": "object",
      "required": ["write", "read", "erasedMediumFiller"],
      "properties": {
        "write": { "type": "string", "enum": ["full-disk", "characterize-at-runtime"] },
        "read": { "type": "string", "enum": ["full", "characterize-at-runtime"] },
        "erasedMediumFiller": { "$ref": "#/$defs/unsignedOrUnknown", "description": "one byte value (0..255) or `unknown`" }
      }
    },
    "allowedTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["partition", "writeOrder", "offsetSectors", "verification"],
        "properties": {
          "partition": { "$ref": "#/$defs/opaqueId" },
          "writeOrder": { "$ref": "#/$defs/unsigned" },
          "offsetSectors": { "$ref": "#/$defs/unsigned" },
          "sourceMember": { "type": "string" },
          "verification": {
            "type": "object",
            "required": ["maxStrengthWhenReadable", "fallback"],
            "properties": {
              "maxStrengthWhenReadable": { "$ref": "#/$defs/verificationStrength" },
              "fallback": {
                "type": "object",
                "required": ["writeCompletionSemantics", "buildPostflight"],
                "properties": {
                  "writeCompletionSemantics": { "$ref": "#/$defs/bool" },
                  "buildPostflight": { "$ref": "#/$defs/bool" }
                }
              }
            }
          }
        }
      }
    },
    "protectedTargets": { "type": "array", "items": { "$ref": "#/$defs/opaqueId" } },
    "dataImpact": {
      "type": "object",
      "required": ["userdata", "calibration", "nonVolatileConfig", "secureStorage"],
      "properties": {
        "userdata": { "$ref": "#/$defs/dataImpactState" },
        "calibration": { "$ref": "#/$defs/dataImpactState" },
        "nonVolatileConfig": { "$ref": "#/$defs/dataImpactState" },
        "secureStorage": { "$ref": "#/$defs/dataImpactState" }
      }
    },
    "recovery": {
      "description": "absent or null means complete-overwrite recovery is unsupported",
      "type": ["object", "null"],
      "required": ["supportsCompleteOverwrite", "version"],
      "properties": {
        "supportsCompleteOverwrite": { "$ref": "#/$defs/bool" },
        "version": { "$ref": "#/$defs/version" },
        "coveredEffects": { "type": "array", "items": { "$ref": "#/$defs/opaqueId" } },
        "unsupportedStates": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/opaqueId" } }
  }
}
