        "facts": {
          "jobId": "JOB-1",
          "stepId": "STEP-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "kind": "stepIntentRecorded",
        "facts": {
          "jobId": "JOB-1",
          "stepId": "STEP-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "kind": "permitConsuming",
        "facts": {
          "jobId": "JOB-1",
          "permitId": "PERMIT-1"
        }
      },
