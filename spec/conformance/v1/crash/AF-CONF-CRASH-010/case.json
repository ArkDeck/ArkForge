{
  "id": "AF-CONF-CRASH-010",
  "suite": "crash",
  "title": "permit consumed with receipt, no checkpoint: checkpoint from the durable receipt",
  "kind": "derive",
  "requirements": ["AF-CRASH-002", "AF-AUTH-P-001", "AF-CRASH-R-005"],
  "description": "Replay the records (subject JOB-1 unless a jobId fact says otherwise; atEpochMs 1010, 1020, …; jobRevision 1), then derive the crash disposition for job JOB-1 and the permit ledger. `journal-frames.bin` holds the same records framed as on disk, without the file magic.",
  "input": {
    "jobId": "JOB-1",
    "records": [
      {
        "kind": "jobCreated",
        "facts": {
          "jobId": "JOB-1"
        }
      },
      {
        "kind": "stepPermitAccepted",
        "facts": {
          "jobId": "JOB-1",
          "stepId": "STEP-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "kind": "stepIntentRecorded",
        "facts": {
          "jobId": "JOB-1",
          "stepId": "STEP-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "kind": "permitConsuming",
        "facts": {
          "jobId": "JOB-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "kind": "externalDispatchStarted",
        "facts": {
          "jobId": "JOB-1",
          "permitId": "PERMIT-1"
        }
      },
      {
        "kind": "semanticReceiptRecorded",
        "facts": {
          "jobId": "JOB-1",
          "permitId": "PERMIT-1",
          "receiptDigest": "abc123"
        }
      },
      {
        "kind": "permitConsumed",
        "facts": {
          "jobId": "JOB-1",
          "permitId": "PERMIT-1",
          "receiptDigest": "abc123"
        }
      }
    ]
  },
  "expected": {
    "crashDisposition": {
      "row": "checkpointFromDurableReceipt",
      "permitsExternalEffect": false,
      "permitId": "PERMIT-1"
    },
    "permitLedger": [
      {
        "permitId": "PERMIT-1",
        "disposition": "consumed",
        "permitsDispatch": false,
        "receiptDigest": "abc123"
      }
    ],
    "unresolvedPermits": []
  },
  "files": {
    "journal-frames.bin": {
      "bytes": 1776,
      "sha256": "ebbb0f44af15626a362381e5bf4b905f3ade0b185ac18f6ce98b477eb62a73c9"
    }
  }
