                      "scalar": "b"
                    }
                  ]
                ]
              },
              {
                "mapping": [
                  [
                    "id",
                    {
                      "scalar": "c"
                    }
                  ],
                  [
                    "backend",
                    {
                      "scalar": "d"
                    }
                  ]
                ]
              }
            ]
          }
        ]
      ]
    }
  },
