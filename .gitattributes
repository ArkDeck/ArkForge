# Conformance fixtures are normative byte sequences. Never let a checkout
# rewrite their line endings, including on Windows with core.autocrlf enabled.
/docs/spec/conformance/** -text

# Published profiles and transcripts are normative inputs to the fixture
# generator, and their file digests are part of the generated contract.
/profiles/** -text
/test/transcripts/** -text

# These scripts are sealed firmware bytes, identical on every build host.
/crates/arkforge-artifact/src/preboot-*.sh -text
